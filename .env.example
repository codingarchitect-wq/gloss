# OpenRouter, for every model Gloss uses. Server-side only. Visitors can also paste their own key in the app.
OPENROUTER_API_KEY=

# Postgres on Neon. Create the tables with `npm run db:migrate`.
DATABASE_URL=

# Any other Postgres (a Docker container, say) works too: its URL is used over node-postgres instead of
# Neon's HTTP driver. DATABASE_DRIVER=neon|pg overrides the choice made from the URL.
# DATABASE_DRIVER=

# Clerk. Accounts are optional; signed in, notes and highlights sync across devices.
# Without Clerk keys there are no accounts, and the library stays in the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The public origin, for canonical and social card URLs.
NEXT_PUBLIC_SITE_URL=https://usegloss.io

# Exa web search, for Fact-check and questions asked with Web on. Optional: without it answers stay inside the text.
EXA_API_KEY=

# LlamaParse, behind "Read it more carefully" on hard PDFs. Optional; only readers with their own OpenRouter key can use it.
LLAMA_CLOUD_API_KEY=

# One reader, always signed in, no Clerk: a personal instance whose library syncs to DATABASE_URL.
# Anyone who can reach the server is that reader, so never set it on a public server. Fixed at build time.
# NEXT_PUBLIC_GLOSS_LOCAL_USER=1

# Saved copies of the originals, made when a text is added: for a page, everything it is made of in one
# HTML file, made with monolith (github.com/Y2Z/monolith), which must be installed (the Docker image has
# it); for a PDF link, the PDF itself.
# GLOSS_ORIGINALS_DIR=/data/originals
